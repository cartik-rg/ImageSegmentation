@prefix : <http://www.robbins-gioia.com/aircraft-ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
 
#################################################################
# Property
#################################################################
 
:part_of rdf:type rdf:Property ;
rdfs:label "part of" .
 
#################################################################
# Top Level
#################################################################
 
:Aircraft rdf:type rdfs:Class .
 
#################################################################
# Major Airframe Assemblies
#################################################################
 
:Fuselage :part_of :Aircraft .
:WingSystem :part_of :Aircraft .
:Empennage :part_of :Aircraft .
:LandingGearSystem :part_of :Aircraft .
:PropulsionSystem :part_of :Aircraft .
:FlightControlSystem :part_of :Aircraft .
:HydraulicSystem :part_of :Aircraft .
:ElectricalSystem :part_of :Aircraft .
:AvionicsSystem :part_of :Aircraft .
:FuelSystem :part_of :Aircraft .
:EnvironmentalControlSystem :part_of :Aircraft .
:CabinInterior :part_of :Aircraft .
 
#################################################################
# Fuselage
#################################################################
 
:ForwardFuselage :part_of :Fuselage .
:CenterFuselage :part_of :Fuselage .
:AftFuselage :part_of :Fuselage .
 
:FuselageSkin :part_of :Fuselage .
:Frames :part_of :Fuselage .
:Stringers :part_of :Fuselage .
:FloorStructure :part_of :Fuselage .
:PressureBulkhead :part_of :Fuselage .
 
:Frame :part_of :Frames .
:Stringer :part_of :Stringers .
:SkinPanel :part_of :FuselageSkin .
 
:Fastener :part_of :SkinPanel .
:Rivet :part_of :Fastener .
:Bolt :part_of :Fastener .
 
:RivetShank :part_of :Rivet .
:RivetHead :part_of :Rivet .
 
:AluminumAlloyRegion :part_of :RivetShank .
:MetalGrainStructure :part_of :AluminumAlloyRegion .
 
#################################################################
# Wings
#################################################################
 
:LeftWing :part_of :WingSystem .
:RightWing :part_of :WingSystem .
 
:WingBox :part_of :LeftWing .
:FrontSpar :part_of :WingBox .
:RearSpar :part_of :WingBox .
:WingRib :part_of :WingBox .
:WingSkinPanel :part_of :WingBox .
 
:Fastener_Wing :part_of :WingSkinPanel .
:ProtectiveCoating :part_of :WingSkinPanel .
:PaintLayer :part_of :ProtectiveCoating .
 
:PigmentRegion :part_of :PaintLayer .
 
#################################################################
