#################################################################
 
:HorizontalStabilizer :part_of :Empennage .
:VerticalStabilizer :part_of :Empennage .
 
:Elevator :part_of :HorizontalStabilizer .
:Rudder :part_of :VerticalStabilizer .
 
:ElevatorHinge :part_of :Elevator .
:HingePin :part_of :ElevatorHinge .
 
